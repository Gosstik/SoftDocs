    // "--enable=E0110,E0203,E1111,E1128,E0701,E0705,E0111,E1003,E0712,E0242,E1141,E0401,E0240,E0239,E2511,E0243,E0244,E1507,E0311,E0313,E0312,E0310,E1139,E0306,E1126,E1127,E1144,E0238,E0236,E0113,E0307,E1130,E2501,E1201,E1200,E0202,E0119,E1125,E4702,E1101,E0211,E0611,E1120,E0301,E1134,E1133,E1701,E1102,E1129,E0702,E0710,E1124,E0114,E1121,E1123,E1143,E0633,E1136,E1137,E1131,E1138,E1135,E0601,W0223,W1402,W0221,W1114,W0237,W0201,W0141,W3601,W0311,W1506,W0143,W0124,W4903,W4904,W4905,W4902,W4901,W6001,W9017,W9018,W0601,W1307,W0236,W1116,W9021,W1306,W9015,W0126,W9006,W9011,W9012,W3101,W9016,W9013,W9014,W4701,W9005,W0233,W1115,W0714,W0239,W0105,W0641,W0407,W0715,W0128,W0621,W0244,W9008,W1503,W9010,W0642,W1507,W0222,W0240,W0231,W0717,W0644,W0632,W0631,W2301,W0101,W0238,W0614,W9019,W0246,W9020,W0125,W2602,W0149,W0716,C2503,C0204,C0203,C2001,C0200,C0209,C3401,C0104,C0403,C0327,C0325,C0302,C0328,C1803,C1802,C0207,C0401,C0402,R1716,R1727,R5601,R1712,R6103,R1713,R6101,R6102,R0401,R0801,R0204,R1726,R1709,R1708,R0903,R0901,R0902",
    // "--enable=F,E,W",
    // "--enable=E1120",
  ],
  "pylint.lintOnChange": false,

  ////----------------------------------------------------------------------////
  //// HTML, JavaScript, TypeScript
  ////----------------------------------------------------------------------////

  "html.format.wrapLineLength": 80,
  "html.format.wrapAttributes": "force",
  "javascript.experimental.updateImportsOnPaste": true,
  "typescript.experimental.updateImportsOnPaste": true,

  ////----------------------------------------------------------------------////
  //// Latex
  ////----------------------------------------------------------------------////

  //// https://mathjiajia.github.io/vscode-and-latex/

  "[latex]": {
    "editor.formatOnSave": false,
    "editor.wordWrap": "on",
    "editor.wrappingIndent": "same",
  },
  "latex-workshop.bibtex-format.trailingComma": true,
  "latex-workshop.intellisense.update.aggressive.enabled": true,
  "latex-workshop.latex.autoBuild.run": "onSave",
  "latex-workshop.latex.autoClean.run": "onFailed",
  "latex-workshop.latex.clean.subfolder.enabled": true,
  "latex-workshop.latex.outDir": "%DIR%/pdf",
  "latex-workshop.linting.chktex.enabled": false,
  "latex-workshop.linting.chktex.exec.args": [
    "-wall",
    "-n22",
    "-n30",
    "-e16",
    "-q",
    "-n1",
    "-n3",
  ],
  "latex-workshop.linting.run": "onType",
  "latex-workshop.latex.build.forceRecipeUsage": false,

  

  ////----------------------------------------------------------------------////
  //// Other
  ////----------------------------------------------------------------------////

  "gitlens.currentLine.enabled": false,
  "gitlens.currentLine.pullRequests.enabled": false,
}

